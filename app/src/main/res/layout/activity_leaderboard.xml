<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/topper"
    tools:context=".Leaderboard">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leaderboard_top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="230dp"
            android:layout_height="36dp"
            app:cardBackgroundColor="@color/topper"
            app:cardCornerRadius="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/leaderboard_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Leaderboard"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="@color/action"
                android:textStyle="bold" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Season / Personal Summary -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_season_outer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        app:cardBackgroundColor="@color/action"
        app:cardCornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/leaderboard_top_bar">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            app:cardCornerRadius="10dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/season_summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/mainer"
                android:padding="16dp">

                <TextView
                    android:id="@+id/current_season_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Season: 2026_T2"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:textColor="@color/action"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/my_rank_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/my_rank_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rank: —"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:textColor="@color/action"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/my_points_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your Points: 0"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/my_tier_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/current_season_text" />

                <TextView
                    android:id="@+id/my_tier_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tier: Bronze"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/my_points_text" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.cardview.widget.CardView>

    <!-- Header Row -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leaderboard_header"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:background="@color/action"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_season_outer">

        <TextView
            android:id="@+id/rank_header_text"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="#"
            android:textColor="@color/topper"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/player_header_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Player"
            android:textColor="@color/topper"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/points_header_text"
            app:layout_constraintStart_toEndOf="@id/rank_header_text"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/points_header_text"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="Points"
            android:textColor="@color/topper"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RecyclerView for leaderboard players -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/leaderboard_recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/leaderboard_header"
        tools:listitem="@layout/item_leaderboard_player" />

    <!-- Loading Spinner -->
    <ProgressBar
        android:id="@+id/leaderboard_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/leaderboard_recycler"
        app:layout_constraintEnd_toEndOf="@id/leaderboard_recycler"
        app:layout_constraintStart_toStartOf="@id/leaderboard_recycler"
        app:layout_constraintTop_toTopOf="@id/leaderboard_recycler" />

    <!-- Empty Text -->
    <TextView
        android:id="@+id/leaderboard_empty_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No leaderboard data yet"
        android:textColor="#555555"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/leaderboard_recycler"
        app:layout_constraintEnd_toEndOf="@id/leaderboard_recycler"
        app:layout_constraintStart_toStartOf="@id/leaderboard_recycler"
        app:layout_constraintTop_toTopOf="@id/leaderboard_recycler" />

</androidx.constraintlayout.widget.ConstraintLayout>