<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".randQus">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101820"
        android:padding="20dp">

        <!-- Screen title -->
        <TextView
            android:id="@+id/randomQuestionsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Random Questions"
            android:textColor="#EAEAEA"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Question card -->
        <LinearLayout
            android:id="@+id/questionCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_result_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp"
            app:layout_constraintBottom_toTopOf="@id/nextQuestionButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/randomQuestionsTitle">

            <TextView
                android:id="@+id/questionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUESTION"
                android:textColor="#B8C7D9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/questionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:padding="16dp"
                android:text="Your advanced math question will appear here."
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Next question button -->
        <Button
            android:id="@+id/nextQuestionButton"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginBottom="30dp"
            android:layout_marginRight="30dp"
            android:layout_marginLeft="30dp"
            android:background="@drawable/rounded_load_button"
            android:gravity="center"
            android:onClick="loadNextQuestion"
            android:text="Next Question"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>