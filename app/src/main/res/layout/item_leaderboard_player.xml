<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_leaderboard_player_outer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/action"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_leaderboard_player_inner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/leaderboard_player_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/mainer"
            android:minHeight="82dp"
            android:padding="12dp">

            <!-- Rank number -->
            <TextView
                android:id="@+id/player_rank_text"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1."
                android:textColor="@color/action"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Avatar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/player_avatar_card"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/player_rank_text"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/player_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/info" />

            </androidx.cardview.widget.CardView>

            <!-- Player name -->
            <TextView
                android:id="@+id/player_name_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Player"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                android:textColor="#222222"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/player_points_text"
                app:layout_constraintStart_toEndOf="@id/player_avatar_card"
                app:layout_constraintTop_toTopOf="@id/player_avatar_card" />

            <!-- Tier -->
            <TextView
                android:id="@+id/player_tier_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:text="Bronze"
                android:textColor="#666666"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/player_points_text"
                app:layout_constraintStart_toStartOf="@id/player_name_text"
                app:layout_constraintTop_toBottomOf="@id/player_name_text" />

            <!-- Last game summary -->
            <TextView
                android:id="@+id/player_last_game_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="8dp"
                android:text="Last: +0 pts"
                android:textColor="#777777"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/player_points_text"
                app:layout_constraintStart_toStartOf="@id/player_name_text"
                app:layout_constraintTop_toBottomOf="@id/player_tier_text" />

            <!-- Points -->
            <TextView
                android:id="@+id/player_points_text"
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0"
                android:textColor="@color/action"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/player_avatar_card" />

            <TextView
                android:id="@+id/player_points_label"
                android:layout_width="86dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="points"
                android:textColor="#777777"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/player_points_text" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.cardview.widget.CardView>