<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="demotheme" parent="Theme.AppCompat.Light.NoActionBar" >
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="statusBarBackground">@color/action</item>
        <item name="colorPrimary">@color/action</item>
        <item name="colorAccent">@color/action</item>
        <item name="colorPrimaryDark">@color/action</item>
        <item name="android:statusBarColor">@color/action</item>
        <item name="colorPrimaryVariant">@color/action</item>
        <item name="colorOnPrimary">@color/action</item>
        <item name="colorOnSecondary">@color/action</item>


    </style>
    <style name="SplashApi" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/action</item>
        <item name="postSplashScreenTheme">@style/demotheme</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Set the splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/anim_logo</item>

        <!-- Set the splash screen animation duration (optional) -->
        <item name="windowSplashScreenAnimationDuration">2000</item>

    </style>
    <style name="SplashScreenTheme" parent="Theme.AppCompat.NoActionBar">

    </style>
